# Server
PORT=3000

# Parity check page (HTTP Basic) — required to enable /parity-check
PARITY_CHECK_USER=qa
PARITY_CHECK_PASSWORD=change-me

# Default Authorization header value when the UI leaves API key empty (e.g. "api-key your-token-here")
PARITY_DEFAULT_API_KEY=

# TOTP MFA Swagger UI at /docs/totp-mfa (optional Basic auth)
# Leave unset to serve docs without auth (local only)
TOTP_DOCS_USER=
TOTP_DOCS_PASSWORD=
